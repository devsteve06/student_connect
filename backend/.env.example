# Backend environment configuration — copy to .env and fill in real values.
# .env is git-ignored; never commit real secrets.

# Port the API listens on (Render provides this automatically in production).
PORT=5000

# development | production
NODE_ENV=development

# REQUIRED. JWT signing secret — the server refuses to start without it.
# Generate a strong value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# OPTIONAL. JWT lifetime (any vercel/ms-style span, e.g. 1d, 12h, 7d). Defaults to 7d.
JWT_EXPIRES_IN=7d

# OPTIONAL. Comma-separated allowlist of browser origins permitted via CORS.
# Leave unset for permissive CORS in local dev; set to your frontend URL(s) in prod.
# CORS_ORIGIN=https://your-frontend.onrender.com

# OPTIONAL. PostgreSQL connection string.
# Leave unset/blank to use the in-memory pg-mem store (data is lost on restart).
# Set to a real connection string for production (e.g. Supabase).
#
# Supabase notes (the data layer auto-enables SSL for *.supabase.co / *.pooler.supabase.com hosts):
#   • Direct host (db.<project-ref>.supabase.co) is IPv6-only — pick the pooler if your
#     network has no IPv6.
#   • Session pooler (works on IPv4, port 5432):
#       postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#     The username must include the project reference after the dot (postgres.<project-ref>).
#   • Do NOT add ?sslmode=... to the URL — it overrides the SSL config set in data/db.js.
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
