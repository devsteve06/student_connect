# Frontend environment configuration — copy to .env (local) or paste into your
# Vercel project's Environment Variables (hosted). Never commit real values.

# Base URL of the backend API, WITHOUT a trailing slash and WITHOUT /api/v1
# (apiClient.js appends the versioned paths itself).
#
# IMPORTANT: Vite inlines import.meta.env.* at BUILD time. Setting this in the
# Vercel dashboard only affects builds that run after the variable is present,
# and changing it requires a redeploy to take effect.
#
# Local development (default, no .env needed):
#   VITE_API_BASE_URL=http://localhost:5000
#
# Production (Render):
#   VITE_API_BASE_URL=https://student-connect-api.onrender.com
# VITE_API_BASE_URL=http://localhost:5000
